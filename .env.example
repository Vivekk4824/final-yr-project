APP_ENV=development
DATABASE_URL=
ALLOW_DESTRUCTIVE_DB_RESET=false
AUTH_HMAC_SECRET=replace-with-random-secret
SESSION_COOKIE_SECURE=false
OTP_PROVIDER=development
# Development only: prints the OTP code without printing the phone number.
OTP_DEBUG=true
NMC_ADMIN_USERNAME=nmc_admin
NMC_ADMIN_PASSWORD=replace-with-password

# Server-side only. Leave empty for map-only navigation with no invented route.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# Comma-separated frontend origins. Use explicit HTTPS origins when deployed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Disabled experiment: category-aware GIS evidence replaces only the Commercial factor.
BUSINESS_AWARE_MCDA_EXPERIMENT=false

# Optional server-side Gemini explanations. The API key must never be exposed
# through VITE_* variables or committed with a real value.
GEMINI_EXPLANATIONS_ENABLED=false
GEMINI_API_KEY=replace-with-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_EXPLANATION_CACHE_SIZE=128
GEMINI_EXPLANATION_RATE_LIMIT=6

# Direct Meta WhatsApp Cloud API (never commit real values)
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
META_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_GRAPH_VERSION=vNN.N

ALLOW_DESTRUCTIVE_DB_RESET=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EXPLANATIONS_ENABLED=true
